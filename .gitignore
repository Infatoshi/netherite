# craster trace harness: binary + regenerable per-run output (sources under trace/ ARE tracked)
c/magma/trace_game
c/magma/trace/world_dump
c/magma/trace/out/
# regenerable render candidates (the mc_pose_*.png goldens ARE tracked)
c/magma/raster/verify/mc_capture/magma_pose_*.png
c/magma/raster/verify/mc_capture/magma_frame.png

# logs + run artifacts
*.log
frame*.png
*.npy


# regenerable gradle / game caches (kept on disk for fast runs, never tracked)
java/Minecraft/run/
java/Minecraft/build/
java/Minecraft/.gradle/
java/Minecraft/.minecraft/
java/Minecraft/.minecraftserver/

# C/CUDA build artifacts (each c/ project also has its own .gitignore)

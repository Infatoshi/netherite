magma/game/*_preview.png
# craster trace harness: binary + regenerable per-run output (sources under trace/ ARE tracked)
magma/trace_game
magma/trace/world_dump
magma/trace/out/
# regenerable render candidates (the mc_pose_*.png goldens ARE tracked)
verify/mc_capture/magma_pose_*.png
verify/mc_capture/magma_frame.png
